<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:elevation="10dp"
    android:id="@+id/headerLayout">

    <!--상단 헤더-->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="35dp"
        app:layout_constraintTop_toTopOf="parent">

        <!--좌측 메뉴명-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/menuImageView"
                android:layout_width="16dp"
                android:layout_height="18dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/home_menu_image"
                app:tint="@color/header_blue"
                />

            <TextView
                android:id="@+id/menutextView"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:text="홈"
                android:fontFamily="@font/paperlogy_semibold"
                android:paddingLeft="8dp"
                android:textSize="18sp"
                android:textColor="@color/header_blue"
                android:lines="1"
                android:maxLines="1"  />

        </LinearLayout>

        <!--우측 토글(홈화면에서만 활성화)-->
        <LinearLayout
            android:id="@+id/toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/toggleImageView"
                android:layout_width="14dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/check_image"
                app:tint="@color/header_blue"/>

            <TextView
                android:id="@+id/toggleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="할일"
                android:fontFamily="@font/paperlogy_semibold"
                android:textSize="18sp"
                android:textColor="@color/header_blue"
                android:layout_marginLeft="7dp"
                android:layout_marginRight="10dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/toggleSwitch"
                style="@style/category_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@null"
                app:trackTint="@null" />

        </LinearLayout>



    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>