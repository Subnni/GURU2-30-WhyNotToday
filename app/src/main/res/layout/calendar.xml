<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <!--년, 월 출력-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:gravity="center_vertical"
        android:layout_marginTop="27dp">

        <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:id="@+id/previousWeekAction"
            android:scaleType="fitEnd"
            android:layout_gravity="center_vertical"
            android:src="@drawable/left_arrow_image" />


        <!--<TextView-->
        <!--    android:id="@+id/weekTextView"-->
        <!--    android:layout_width="0dp"-->
        <!--    android:layout_height="wrap_content"-->
        <!--    android:layout_weight="2.4"-->
        <!--    android:fontFamily="@font/paperlogy_semibold"-->
        <!--    android:text="- 주차"-->
        <!--    android:textAlignment="center"-->
        <!--    android:textColor="#3300ff"-->
        <!--    android:textSize="18sp" />-->

        <TextView
            android:id="@+id/monthYearTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.5"
            android:text="2026년 0월"
            android:textAlignment="center"
            android:fontFamily="@font/paperlogy_semibold"
            android:textColor="@color/gray"
            android:textSize="15sp" />

        <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:id="@+id/nextWeekAction"
            android:layout_gravity="center_vertical"
            android:scaleType="fitStart"
            android:src="@drawable/right_arrow_image" />

    </LinearLayout>
    <!--주차 선택 -> 삭제 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="40dp"
        android:orientation="horizontal">
    </LinearLayout>
    <!--달력-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="45dp"
        android:layout_marginRight="45dp"
        android:layout_marginBottom="25dp"

        android:orientation="vertical">

        <!--날짜-->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/calendarRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="7"
            tools:itemCount="7"
            tools:listitem="@layout/calendar_cell" />
    </LinearLayout>
</LinearLayout>

